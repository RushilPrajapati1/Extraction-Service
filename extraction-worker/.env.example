# Storage backend for raw uploaded PDFs.
#
#   local  (default)  writes to ./uploads/
#   gcs               writes to gs://$GCS_BUCKET/
#
# The gcs values come from `terraform -chdir=../infra output worker_env`.

STORAGE_BACKEND=local

# GCS_BUCKET=my-prefix-extraction-documents-dev
# GCS_PREFIX=documents/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
